{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "Dockerfile",
      "*.sql",
      "*.docx",
      "*.pdf"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "online-exam-system",
          "region": "us-central1"
        }
      }
    ]
  }
}
